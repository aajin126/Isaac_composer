+float RVOSimulator::getAgentAvoidanceResponsibility(std::size_t agentNo,
+                                                   std::size_t otherNo) const {
+  for (const auto &neighbor : agents_[agentNo]->agentNeighbors_) {
+    if (neighbor.second == agents_[otherNo]) {
+      return agents_[agentNo]->avoidanceResponsibility(agents_[otherNo]);
+    }
+  }
+  return -1.0F; // No ORCA agent constraint for this directed pair.
+}
