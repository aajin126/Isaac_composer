+bool Agent::queryVelocity(const Vector2 &objective, bool directionOpt, Vector2 &result) const {
+  return linearProgram2(orcaLines_, maxSpeed_, objective, directionOpt, result) == orcaLines_.size();
+}
+
+float Agent::avoidanceResponsibility(const Agent *other) const {
+  if (externallyControlled_) return 0.0F;
+  if (other->externallyControlled_) return 1.0F;
+  if (avoidanceResponsibilities_.empty()) return 0.5F;
+  // A short mu-dependent range (or neighbor budget) may hide us from the
+  // other pedestrian. Never delegate avoidance to someone with no constraint.
+  bool reciprocal = false;
+  for (const auto &neighbor : other->agentNeighbors_) {
+    if (neighbor.second == this) { reciprocal = true; break; }
+  }
+  if (!reciprocal) return 1.0F;
+  return avoidanceResponsibilities_[other->id_];
+}
